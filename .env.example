# ── Copy this to .env for local development ──
# On Railway, set these in the service's "Variables" tab instead.

# PostgreSQL connection string.
# Railway auto-provides this when you add a PostgreSQL plugin (Reference it as ${{Postgres.DATABASE_URL}}).
DATABASE_URL=postgresql://user:password@localhost:5432/media_manager

# Free Google Gemini key for writing posts: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional: which Gemini model to use (defaults to gemini-2.0-flash — free tier).
# GEMINI_MODEL=gemini-2.0-flash

# Long random string used to encrypt Facebook tokens at rest. Set ANY long random value.
APP_SECRET=please-change-me-to-a-long-random-string

# Port (Railway sets this automatically; default 3000 locally).
# PORT=3000
